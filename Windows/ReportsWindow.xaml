<Window x:Class="WpfApp1.Windows.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="680" Height="500"
        Title="Отчеты и аналитика"
        SnapsToDevicePixels="True">

    <Border Background="{DynamicResource BgBrush}" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="20"
            RenderOptions.EdgeMode="Aliased">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkerBrush}" MouseDown="Title_MouseDown"
                CornerRadius="18,18,0,0">
            <Grid>
                <TextBlock Text="📊 Отчеты и аналитика" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" Margin="20,0"/>
                <Button Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="White" FontSize="14"
                        Cursor="Hand" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                    BorderBrush="#FFFFFF66" BorderThickness="1.5" Width="28" Height="28">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFFFF33"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ReportsScrollViewer" Grid.Row="1" Style="{StaticResource CustomScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="20,16,0,0">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Общая сводка" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TotalCountText" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="Всего единиц" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TotalCostText" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Общая стоимость" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="По типам устройств" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ByTypeList" FontSize="13"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="По состоянию" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ByConditionList" FontSize="13"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Стоимость ремонтов и замен за год" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="2"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="100">
                                <TextBox x:Name="TbYear" FontSize="13" Padding="8,4" Background="Transparent"
                                         BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                         PreviewTextInput="TbYear_PreviewTextInput" MaxLength="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="📊 Сформировать" Style="{StaticResource PrimaryButton}"
                                        Height="34" FontSize="12" Padding="14,6" Click="ShowRepairCost_Click"/>
                                <TextBlock x:Name="RepairCostResult" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Экспорт данных по фильтру" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тип" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"/>
                                <ComboBox x:Name="FilterType" FontSize="13" Padding="8,4" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Состояние" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"/>
                                <ComboBox x:Name="FilterCondition" FontSize="13" Padding="8,4" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Расположение" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"/>
                                <ComboBox x:Name="FilterLocation" FontSize="13" Padding="8,4" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="FilterAgeCheck" VerticalAlignment="Center" FontSize="13"
                                      Foreground="{DynamicResource TextBrush}" Content="Техника старше (лет):"/>
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="2"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBox x:Name="FilterAgeValue" FontSize="13" Padding="6,2" Background="Transparent"
                                         BorderThickness="0" Foreground="{DynamicResource TextBrush}" Text="3"
                                         PreviewTextInput="Filter_PreviewTextInput" MaxLength="2"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔍 Найти" Style="{StaticResource PrimaryButton}"
                                    Height="34" FontSize="12" Padding="14,6" Click="GenerateFiltered_Click"/>
                            <Button x:Name="ExportBtn" Content="📥 Экспорт в Excel"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="34" FontSize="12" Padding="14,6" Margin="8,0,0,0" IsEnabled="False"
                                    Click="ExportFiltered_Click"/>
                        </StackPanel>

                        <ItemsControl x:Name="FilteredList" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="14,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,18,18">
            <Button Content="Закрыть" Width="100" Height="34"
                    Style="{StaticResource PrimaryButton}" FontSize="12"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Border>
    </Grid>
</Border>
</Window>
