<Window x:Class="WpfApp1.Windows.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="400" Height="Auto"
        SizeToContent="Height"
        Title="Диалог"
        SnapsToDevicePixels="True">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="20"
            RenderOptions.EdgeMode="Aliased">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkerBrush}" CornerRadius="18,18,0,0"
                    MouseDown="Title_MouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="✕" Width="24" Height="24"
                            Background="Transparent" Foreground="White" FontSize="12"
                            Cursor="Hand" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Click="Cancel_Click" x:Name="CloseButton">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12" Background="{TemplateBinding Background}"
                                        BorderBrush="#FFFFFF66" BorderThickness="1.5" Width="24" Height="24">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF33"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,12">
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" LineHeight="20"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="14,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,18,18">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Отмена" Width="100" Height="34" FontSize="12" Cursor="Hand"
                            Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Margin="0,0,8,0" Click="Cancel_Click" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        Padding="14,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="OkBtn" Content="OK" Width="100" Height="34" FontSize="12"
                            Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
