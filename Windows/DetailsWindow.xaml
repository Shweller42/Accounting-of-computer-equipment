<Window x:Class="WpfApp1.Windows.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="700" Height="520"
        Title="Карточка техники"
        SnapsToDevicePixels="True">

    <Border Background="{DynamicResource BgBrush}" BorderBrush="#000000" BorderThickness="1.5" CornerRadius="20"
            RenderOptions.EdgeMode="Aliased">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryDarkerBrush}" MouseDown="Title_MouseDown"
                CornerRadius="18,18,0,0">
            <Grid>
                <TextBlock x:Name="TitleText" Text="Карточка техники" FontSize="16" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" Margin="20,0"/>
                <Button Content="✕" Width="28" Height="28"
                        Background="Transparent" Foreground="White" FontSize="14"
                        Cursor="Hand" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                    BorderBrush="#FFFFFF66" BorderThickness="1.5" Width="28" Height="28">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFFFF33"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" FontSize="13" Background="Transparent" BorderThickness="0" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,2"
                                            Padding="{TemplateBinding Padding}" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="📋 Информация">
                    <ScrollViewer Style="{StaticResource CustomScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel x:Name="InfoPanel" Margin="4,0,0,0"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="📜 Журнал работ">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="WorkLogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  RowHeaderWidth="0" FontSize="12" GridLinesVisibility="Horizontal"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                                  AlternatingRowBackground="{DynamicResource PrimaryLighterBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="6,6"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding EventType}" Width="110"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat=N2}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Content="➕ Добавить событие" Style="{StaticResource PrimaryButton}"
                                Height="34" FontSize="12" HorizontalAlignment="Left"
                                Width="160" Padding="12,4" Click="AddWorkLog_Click"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="16,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,18,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditBtn" Content="✏️ Редактировать" Style="{StaticResource PrimaryButton}"
                        Height="34" Padding="16,6" Click="Edit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Border>
</Window>
